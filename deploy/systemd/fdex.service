[Unit]
Description=FDEX FastAPI Server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/fdex/server
ExecStart=/opt/fdex/server/.venv/bin/python -m app.run
Restart=always
RestartSec=5
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
