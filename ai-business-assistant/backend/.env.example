# 后端基础配置
APP_NAME=AI业务落地助手
SECRET_KEY=change-me-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# 默认使用当前 backend 目录下的 SQLite 文件；应用启动时会自动建表
DATABASE_URL=sqlite:///./ai_business_assistant.db

# 上传文件保存目录；应用启动时会自动创建
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=50

# 允许访问后端的前端地址，多个地址用英文逗号分隔
# 公网部署时必须追加实际前端访问地址，例如 http://203.0.113.10:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://203.0.113.10:5173

# AI Provider 配置
# AI_API_KEY 为空时自动使用 MockAIProvider；填写后使用 OpenAICompatibleProvider 调用 Chat Completions API。
# AI_BASE_URL 可以是服务根地址（如 https://api.openai.com/v1），也可以直接写到 /chat/completions。
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL_TEXT=gpt-4o-mini
AI_MODEL_VISION=gpt-4o-mini
AI_MODEL_SUMMARY=gpt-4o-mini
AI_MODEL_CODE=gpt-4o-mini
AI_MODEL_INDUSTRY=gpt-4o-mini
AI_TIMEOUT_SECONDS=60
