# 后端基础配置
APP_NAME=AI业务落地助手
SECRET_KEY=change-me-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# 默认使用当前 backend 目录下的 SQLite 文件；应用启动时会自动建表
DATABASE_URL=sqlite:///./ai_business_assistant.db

# 上传文件保存目录；应用启动时会自动创建
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=50

# 前端开发服务器地址，多个地址用英文逗号分隔
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# MVP 默认使用 MockAIProvider，不需要外部 AI Key；以下配置为后续接入真实模型预留
AI_BASE_URL=
AI_API_KEY=
AI_MODEL_TEXT=mock-text
AI_MODEL_VISION=mock-vision
AI_MODEL_SUMMARY=mock-summary
AI_MODEL_CODE=mock-code
AI_MODEL_INDUSTRY=mock-industry
