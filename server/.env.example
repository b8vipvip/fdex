APP_NAME=FDEX Server
APP_VERSION=1.0.0
ENVIRONMENT=production
PUBLIC_BASE_URL=https://fdex.k2n.cn
API_PREFIX=/api
CORS_ORIGINS=https://fdex.k2n.cn

FDEX_HOST=127.0.0.1
FDEX_PORT=18080
FDEX_WORKERS=2

# FDEX 中心统一账号认证。user_id 是 GitHub/项目/Coding Agent 沙箱的唯一账号归属。
# Web 用户中心 /account/login 同时提供注册和找回密码入口；管理员可在 /admin/mail 管理邮件与验证配置。
FDEX_AUTH_REGISTRATION_ENABLED=true
FDEX_AUTH_ACCESS_MINUTES=60
FDEX_AUTH_REFRESH_DAYS=30
FDEX_AUTH_LOGIN_MAX_FAILURES=5
FDEX_AUTH_LOGIN_WINDOW_MINUTES=10
FDEX_AUTH_LOGIN_BLOCK_MINUTES=15
FDEX_AUTH_RESET_CODE_MINUTES=10
FDEX_AUTH_RESET_MAX_ATTEMPTS=5

# FDEX 账号安全邮件 SMTP。
FDEX_SMTP_HOST=
FDEX_SMTP_PORT=587
FDEX_SMTP_USERNAME=
FDEX_SMTP_PASSWORD=
FDEX_SMTP_FROM_EMAIL=
FDEX_SMTP_FROM_NAME=FDEX
FDEX_SMTP_STARTTLS=true
FDEX_SMTP_SSL=false
FDEX_SMTP_TIMEOUT_SECONDS=15

# 可选 IMAP 收件配置。
FDEX_IMAP_HOST=
FDEX_IMAP_PORT=993
FDEX_IMAP_USERNAME=
FDEX_IMAP_PASSWORD=
FDEX_IMAP_MAILBOX=INBOX
FDEX_IMAP_SSL=true
FDEX_IMAP_STARTTLS=false
FDEX_IMAP_TIMEOUT_SECONDS=15

# 旧单供应商字段仅用于兼容迁移。实际 AI 请求统一走“供应商管理”模型池。
AI_PROVIDER=openai_compatible
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4.1-mini
AI_TIMEOUT_SECONDS=60

# Coding Agent 不单独配置 AI 接口/API Key/模型。Agent 权限开启后唯一执行核心为
# OpenAI 官方 Codex app-server；不存在 legacy/auto engine selector 或普通 AI 回退。
# Runtime/Provider 未满足 Phase 7.33 fresh-full rollout gate 时任务直接 fail-closed。
FDEX_AGENT_ENABLED=true
# 可选：固定一个由运维安装/验证的官方 codex 二进制。留空时优先使用 PATH 中的 codex，
# 再回退到 openai-codex-cli-bin 随 server/requirements.txt 安装的官方 bundled Runtime。
FDEX_AGENT_CODEX_BIN=
# 一个 FDEX user_id 使用一个独立 CODEX_HOME；Codex 的 thread/history/skills/hooks/plugin/MCP
# 本地配置可以在同一用户任务间延续，但绝不会跨 FDEX 账号共享。
FDEX_AGENT_CODEX_HOME_ROOT=/opt/fdex/server/data/codex
FDEX_AGENT_ACCESS_TOKEN=
FDEX_AGENT_WORKSPACE=/opt/fdex
FDEX_AGENT_WORKTREE_ROOT=/opt/fdex/server/data/agent-worktrees
FDEX_AGENT_SANDBOX_ROOT=/opt/fdex/server/data/agent-sandboxes
FDEX_AGENT_DEFAULT_OWNER=local
FDEX_AGENT_COMMAND_TIMEOUT_SECONDS=30
FDEX_AGENT_BUILD_TIMEOUT_SECONDS=900
FDEX_AGENT_MAX_OUTPUT_CHARS=20000
FDEX_AGENT_MAX_FILE_CHARS=200000
FDEX_AGENT_MAX_STEPS=10
FDEX_AGENT_MODEL_MAX_TOKENS=1600
FDEX_AGENT_SANDBOX_MEMORY_MB=2048
FDEX_AGENT_SANDBOX_CPU_PERCENT=150
FDEX_AGENT_SANDBOX_PIDS_MAX=512
FDEX_AGENT_SANDBOX_MAX_CONCURRENT=1
FDEX_AGENT_ACCOUNT_DISK_MB=20480

# Phase 7.7 首选路径：GitHub App Installation。
FDEX_GITHUB_APP_ID=
FDEX_GITHUB_APP_SLUG=
FDEX_GITHUB_APP_CLIENT_ID=
FDEX_GITHUB_APP_CLIENT_SECRET=
FDEX_GITHUB_APP_PRIVATE_KEY_PATH=/opt/fdex/server/secrets/github-app.pem
FDEX_GITHUB_APP_PRIVATE_KEY_B64=
FDEX_GITHUB_APP_FLOW_MINUTES=10

# FDEX 中心服务器访问 GitHub 的网络出口。
FDEX_GITHUB_HTTP_PROXY=
FDEX_GITHUB_CONNECT_TIMEOUT_SECONDS=10
FDEX_GITHUB_READ_TIMEOUT_SECONDS=60
FDEX_GITHUB_RETRY_ATTEMPTS=3

# Phase 7.6 兼容路径：旧版 FDEX 用户 Web OAuth。
FDEX_GITHUB_WEB_OAUTH_CLIENT_ID=
FDEX_GITHUB_WEB_OAUTH_CLIENT_SECRET=
FDEX_GITHUB_WEB_OAUTH_SCOPE="repo read:user"
FDEX_GITHUB_WEB_OAUTH_FLOW_MINUTES=10

# Phase 7.5 兼容路径：旧 Android 客户端 GitHub Device OAuth。
FDEX_GITHUB_OAUTH_CLIENT_ID=
FDEX_GITHUB_OAUTH_SCOPE="repo read:user offline_access"
FDEX_GITHUB_OAUTH_REFRESH_SKEW_SECONDS=300

FDEX_MEMORY_ENABLED=true
FDEX_MEMORY_MANAGED_STACK=true
FDEX_MEMORY_REQUIRED=false
FDEX_MEMORY_DATA_DIR=/opt/fdex/server/data/memory
FDEX_MEMORY_CONTEXT_MAX_CHARS=8000
FDEX_MEMORY_SYSTEM_MAX_CHARS=11900
FDEX_MEMORY_RECALL_LIMIT=6
FDEX_MEMORY_RECALL_TIMEOUT_SECONDS=12
FDEX_MEMORY_WRITE_TIMEOUT_SECONDS=180

FDEX_MEMORY_PROXY_URL=http://127.0.0.1:18100/v1
FDEX_MEMORY_PROXY_TOKEN=
FDEX_MEMORY_PROXY_PORT=18100
FDEX_MEMORY_EMBEDDING_MODEL=text-embedding-3-small
FDEX_MEMORY_EMBEDDING_DIMENSION=1536
FDEX_MEMORY_EMBEDDING_MAX_CHARS=12000
FDEX_MEMORY_QDRANT_URL=http://127.0.0.1:6333
FDEX_MEMORY_QDRANT_PORT=6333
FDEX_MEMORY_QDRANT_COLLECTION=fdex_mempalace_remote_v1
FDEX_MEMORY_QDRANT_TIMEOUT_SECONDS=20

FDEX_LETTA_ENABLED=true
FDEX_LETTA_BASE_URL=http://127.0.0.1:8283
FDEX_LETTA_PORT=8283
FDEX_LETTA_SERVER_PASSWORD=
FDEX_LETTA_ENCRYPTION_KEY=
FDEX_LETTA_MODEL=openai/gpt-4o-mini
FDEX_LETTA_EMBEDDING=openai/text-embedding-3-small
FDEX_LETTA_TIMEOUT_SECONDS=120

ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
ADMIN_COOKIE_SECURE=true
ADMIN_SESSION_HOURS=12

GITHUB_REPO=b8vipvip/fdex
GITHUB_TOKEN=
RELEASE_CACHE_DIR=/opt/fdex/server/data/releases

APP_DIR=/opt/fdex
SERVICE_NAME=fdex
ADMIN_LOG_LINES=300
