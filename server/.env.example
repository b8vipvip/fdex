APP_NAME=FDEX Server
APP_VERSION=1.0.0
ENVIRONMENT=production
PUBLIC_BASE_URL=https://fdex.k2n.cn
API_PREFIX=/api
CORS_ORIGINS=https://fdex.k2n.cn

# FDEX 独立监听端口。仅监听本机，不需要开放安全组端口。
FDEX_HOST=127.0.0.1
FDEX_PORT=18080
FDEX_WORKERS=2

# 第三方 AI/API 配置仅保存在服务端，不会返回给 Android 客户端。
AI_PROVIDER=openai_compatible
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4.1-mini
AI_TIMEOUT_SECONDS=60

# 管理后台。首次运行 update_server.sh 时会自动生成缺失的密码和会话密钥。
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
ADMIN_COOKIE_SECURE=true
ADMIN_SESSION_HOURS=12

# GitHub Release 只由服务端同步；Android 客户端不会直接访问 GitHub。
GITHUB_REPO=b8vipvip/fdex
# 可选：GitHub PAT，可提高 API 限额。公开仓库不填也能工作。
GITHUB_TOKEN=
RELEASE_CACHE_DIR=/opt/fdex/server/data/releases

# 运维设置，不建议从公网暴露或随意修改。
APP_DIR=/opt/fdex
SERVICE_NAME=fdex
ADMIN_LOG_LINES=300
