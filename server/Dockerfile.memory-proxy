FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app
COPY requirements-memory-proxy.txt .
RUN pip install --no-cache-dir -r requirements-memory-proxy.txt
COPY app ./app

EXPOSE 18100
CMD ["python", "-m", "uvicorn", "app.memory_provider_proxy_v2:app", "--host", "0.0.0.0", "--port", "18100"]
